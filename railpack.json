{
    "$schema": "https://schema.railpack.com",
    "phpExtensions": [
        "intl",
        "zip",
        "gd",
        "pdo_mysql"
    ],
    "cmds": {
        "install": "composer install --optimize-autoloader --no-scripts --no-interaction --ignore-platform-reqs"
    },
    "deploy": {
        "startCommand": "php artisan serve --host=0.0.0.0 --port=$PORT"
    }
}